# Public Supabase values are required in browser and server runtimes.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only privileged Supabase credential. Prefer the current sb_secret_* key.
# SUPABASE_SERVICE_ROLE_KEY is supported only as a legacy fallback during migration.
# Never expose either value through NEXT_PUBLIC_* or client code.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# SUPABASE_SERVICE_ROLE_KEY=service_role_REPLACE_ME

# Server-only. Required by the governed support endpoint; use the approved OpenAI-compatible gateway in production.
OPENAI_API_BASE=https://YOUR_OPENAI_COMPATIBLE_GATEWAY/v1
OPENAI_API_KEY=REPLACE_ME

# Delivery providers are intentionally not configured in source. Configure approved email/SMS/push credentials
# only in the deployment secret store before enabling a dispatcher; the database outbox remains the source of truth.

# Server-only. Required to send and confirm patient-phone OTPs through Twilio Verify.
# Do not configure these values in NEXT_PUBLIC_* variables or source-controlled files.
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_ME
TWILIO_API_KEY=SK_REPLACE_ME
TWILIO_API_SECRET=REPLACE_ME
