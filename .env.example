NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never expose this variable through NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=service_role_REPLACE_ME

# Server-only. Required by the governed support endpoint; use the approved OpenAI-compatible gateway in production.
OPENAI_API_BASE=https://YOUR_OPENAI_COMPATIBLE_GATEWAY/v1
OPENAI_API_KEY=REPLACE_ME

# Delivery providers are intentionally not configured in source. Configure approved email/SMS/push credentials
# only in the deployment secret store before enabling a dispatcher; the database outbox remains the source of truth.
